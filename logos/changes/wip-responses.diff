+/// ChatGPT Codex backend base URL — the ONLY endpoint that accepts ChatGPT
+/// subscription OAuth tokens. api.openai.com rejects them with 403 "Missing
+/// scopes" (the OAuth grant carries no `api.*` scopes). This is the same
+/// backend the official codex CLI talks to; our OAuth client id IS codex
+/// CLI's public client.
+pub const CODEX_BACKEND_BASE: &str = "https://chatgpt.com/backend-api/codex";
+
+/// Models reachable with a ChatGPT subscription login: the gpt-5 family and
+/// codex models. Platform-only models (gpt-4o, gpt-4.1, o3, ...) are NOT
+/// covered by a Plus/Pro subscription and 403 on the Codex backend.
+pub fn is_chatgpt_subscription_model(model: &str) -> bool {
+    let m = model.to_lowercase();
+    m.starts_with("gpt-5") || m.starts_with("codex")
+}
