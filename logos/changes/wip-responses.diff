+        self
+    }
+
+    /// Whether requests target the Codex backend (changes request shape:
+    /// `store: false`, stream-only, `instructions` instead of system input).
+    fn is_codex_backend(&self) -> bool {
+        self.base_url == CODEX_BACKEND_BASE
+    }
+
+    /// Apply auth plus (Codex-only) routing headers to an outgoing request.
+    fn apply_headers(&self, req: reqwest::RequestBuilder) -> reqwest::RequestBuilder {
+        let req = req
+            .header(
+                "Authorization",
+                format!("Bearer {}", self.api_key.expose_secret()),
+            )
+            .header("Content-Type", "application/json");
+        if !self.is_codex_backend() {
+            return req;
+        }
+        // The backend keys client behavior and quota off the originator;
+        // the OAuth client id we log in with is codex CLI's public client.
+        let mut req = req
+            .header("OpenAI-Beta", "responses=experimental")
+            .header("originator", "codex_cli_rs");
+        if let Some(account) = &self.chatgpt_account_id {
+            req = req.header("chatgpt-account-id", account);
+        }
+        if let Some(session) = &self.session_id {
+            req = req.header("session_id", session);
+        }
+        req
+    }
